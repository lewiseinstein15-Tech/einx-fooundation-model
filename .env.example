# ===================================
# EINX Foundation Model — environment variables
# ===================================
# Copy this file to .env and fill in real values.
# All values are OPTIONAL — EINX runs with sensible defaults.

# --- Hardware ---
# Force a specific device: "cpu" | "cuda" | "mps" | "auto"
EINX_DEVICE=auto

# --- API server ---
EINX_API_HOST=0.0.0.0
EINX_API_PORT=8000

# --- Logging ---
EINX_LOG_LEVEL=INFO

# --- Reproducibility ---
EINX_SEED=42

# --- Training (overrides config when set) ---
# EINX_BATCH_SIZE=4
# EINX_GRAD_ACCUM_STEPS=8
# EINX_LEARNING_RATE=3e-4

# --- Experiment tracking (optional) ---
# EINX_WANDB_PROJECT=einx
# EINX_WANDB_API_KEY=

# --- Distributed training (future — Phase 2/3) ---
# EINX_WORLD_SIZE=1
# EINX_LOCAL_RANK=0
